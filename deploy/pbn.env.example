# Копировать в /etc/pbn/pbn.env (chmod 600, владелец root) и заполнить.
# Реальный файл в репозиторий НЕ кладём.

# Секретный ключ между сайтом и сервисом. Сгенерировать: openssl rand -hex 32
PBN_API_KEY=ЗАМЕНИТЬ

# Путь к реальной палитре красок (JSON, формат в pbn_engine/palette.py).
# Пока файла нет, работает плацехолдер.
# PBN_PALETTE_PATH=/etc/pbn/palette.json

PBN_MAX_UPLOAD_MB=15
PBN_RATE_LIMIT_PER_MIN=20
PBN_MAX_CONCURRENT=2
